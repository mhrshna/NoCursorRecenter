{
  "schemaVersion": 1,
  "id": "pausecursorfix",
  "version": "${version}",
  "name": "No Cursor Recenter",
  "description": "Prevents cursor recentering when switching away from Minecraft or opening menus. Keeps normal pause behavior.",
  "license": "MIT",
  "authors": [
    "mhrshna"
  ],
  "environment": "client",
  "mixins": [
    {
      "config": "pausecursorfix.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "minecraft": "=${minecraft_version}",
    "java": ">=25"
  }
}
